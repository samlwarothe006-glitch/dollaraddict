/* Reset and global styles */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
}

body {
    background-color: #f4f7f6;
    color: #333;
    line-height: 1.6;
}

/* Navigation bar */
header {
    background: #1e293b;
    color: #fff;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

header .logo {
    font-size: 1.5rem;
    font-weight: bold;
}

header nav ul {
    display: flex;
    list-style: none;
}

header nav ul li {
    margin-left: 20px;
}

header nav ul li a {
    color: #fff;
    text-decoration: none;
    transition: color 0.3s;
}

header nav ul li a:hover {
    color: #38bdf8;
}

/* Sections */
section {
    padding: 3rem 2rem;
    max-width: 900px;
    margin: auto;
}

#hero {
    text-align: center;
    padding: 5rem 2rem;
    background: #e2e8f0;
    border-radius: 8px;
    margin-top: 2rem;
}

#hero h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
}

button {
    margin-top: 1.5rem;
    padding: 0.75rem 1.5rem;
    background-color: #0284c7;
    color: #fff;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 1rem;
}

button:hover {
    background-color: #0369a1;
}

footer {
    text-align: center;
    padding: 1.5rem;
    background: #1e293b;
    color: #94a3b8;
    margin-top: 2rem;
}